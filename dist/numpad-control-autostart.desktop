[Desktop Entry]
Type=Application
Name=NumpadPilot
Comment=Waits in the system tray so the settings open instantly
GenericName=Numpad Pilot
Keywords=Numpad Pilot;NumpadPilot;numpad;pilot;numpad control;macro pad;
Exec=@HOME@/.local/bin/numpad-control --hidden
Icon=@DIR@/assets/icon-256.png
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
