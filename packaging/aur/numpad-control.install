post_install() {
  echo "NumpadControl: turn the background service on with"
  echo "    systemctl --user enable --now numpad-control"
  echo "then open NumpadControl from your app menu and use Settings -> Detect to pick your numpad."
  echo "The built-in permission rule covers the numpad c0f4:05f5; for another model copy"
  echo "/usr/lib/udev/rules.d/70-numpad-control.rules to /etc/udev/rules.d/ and change the two ids."
}
post_upgrade() {
  echo "NumpadControl: restart the service to use the new version:  systemctl --user restart numpad-control"
}
