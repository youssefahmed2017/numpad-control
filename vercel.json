{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p site/img/screenshots && cp docs/screenshots/*.png site/img/screenshots/",
  "outputDirectory": "site",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- site docs/screenshots vercel.json api package.json package-lock.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/issues-attachments/:name",
      "destination": "/api/attachment?name=:name"
    }
  ]
}
