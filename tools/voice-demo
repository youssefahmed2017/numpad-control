#!/usr/bin/env python3
"""Hear your voice changer without a working microphone.

    tools/voice-demo CLIP            # any audio or video file with a voice (or music) in it
    tools/voice-demo CLIP --seconds 10 --start 20 --out ~/Music/voice-demo

It plays a short part of CLIP into a silent virtual microphone, lets EasyEffects change it with each of your
microphone voices (the presets you use with the voice keys), and saves one file per voice, so you can listen to what each
one sounds like: 00-original, then Normal, Deep Voice, ... Nothing plays through your speakers while it runs.

It puts everything back as it was: your default microphone, the voice that was loaded, EasyEffects running or not."""
import argparse
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from numpadctl import voice  # noqa: E402

SINK = "numpad_voice_demo"


def run(*argv, **kwargs):
    return subprocess.run(argv, capture_output=True, text=True, **kwargs).stdout.strip()


def safe_name(text):
    return "".join(c if c.isalnum() or c in " -_" else "_" for c in text).strip()


def make_excerpt(clip, start, seconds, target):
    done = subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", str(start), "-t", str(seconds), "-i", str(clip), "-vn",
                           "-ac", "1", "-ar", "48000", str(target)], capture_output=True, text=True)
    if done.returncode != 0 or not target.exists() or target.stat().st_size < 10000:
        sys.exit(f"could not read audio from {clip}: {done.stderr.strip()[:200] or 'nothing to play at that point'}")


def stop(process):
    if process is not None and process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.kill()


def main():
    parser = argparse.ArgumentParser(description="Hear your voice changer without a working microphone.")
    parser.add_argument("clip", type=Path, help="an audio or video file with something to hear in it")
    parser.add_argument("--seconds", type=float, default=8, help="how much of it to use (default 8)")
    parser.add_argument("--start", type=float, default=0, help="where in the clip to start, in seconds")
    parser.add_argument("--out", type=Path, default=Path.home() / "Music" / "voice-demo", help="where to put the files")
    args = parser.parse_args()
    for tool in ("ffmpeg", "pw-play", "pw-record", "pactl", "easyeffects"):
        if not shutil.which(tool):
            sys.exit(f"{tool} is needed and isn't installed")
    if not args.clip.exists():
        sys.exit(f"{args.clip} does not exist")
    names = voice.presets("input")
    if not names:
        sys.exit("you have no EasyEffects microphone voices yet (make them in EasyEffects, Microphone tab)")
    names = sorted(names, key=lambda n: (n != "Normal", n))  # the unprocessed one first
    old_source = run("pactl", "get-default-source")
    if "easyeffects" in old_source or SINK in old_source:
        sys.exit(f"your default microphone is {old_source}: something left it switched, fix that first")

    work = Path(tempfile.mkdtemp(prefix="numpad-voice-demo-"))
    args.out.mkdir(parents=True, exist_ok=True)
    clip = work / "clip.wav"
    make_excerpt(args.clip, args.start, args.seconds, clip)
    shutil.copy(clip, args.out / "00-original.wav")

    was_running = voice.running()
    before = (voice.current_preset(), voice.bypassed()) if was_running else None
    module = player = recorder = our_easyeffects = None
    try:
        module = run("pactl", "load-module", "module-null-sink", f"sink_name={SINK}",
                     f"sink_properties=device.description=NumpadPilotVoiceDemo")  # a silent virtual microphone
        run("pactl", "set-default-source", f"{SINK}.monitor")
        if not was_running:
            our_easyeffects = subprocess.Popen(["easyeffects", "--service-mode"], stdin=subprocess.DEVNULL,
                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        voice.ensure_running()
        time.sleep(2)
        for number, name in enumerate(names, start=1):
            print(f"  {name} ...", flush=True)
            voice.load(name)
            time.sleep(1.5)
            target = args.out / f"{number:02d}-{safe_name(name)}.wav"
            recorder = subprocess.Popen(["pw-record", "--target", "easyeffects_source", "--rate", "48000", "--channels", "1",
                                         str(target)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.5)
            player = subprocess.Popen(["pw-play", "--target", SINK, str(clip)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            player.wait(timeout=args.seconds + 15)
            time.sleep(0.7)
            stop(recorder)
    finally:
        stop(player)
        stop(recorder)
        if before is not None:  # EasyEffects was running before: give it back its voice and its on/off state
            try:
                if before[0]:
                    voice.load(before[0])
                voice.set_bypass(before[1])
            except voice.VoiceError:
                pass
        stop(our_easyeffects)  # (only if this tool started it)
        time.sleep(1)
        run("pactl", "set-default-source", old_source)
        if module:
            run("pactl", "unload-module", module)
        shutil.rmtree(work, ignore_errors=True)
    print(f"\nsaved in {args.out}:")
    for file in sorted(args.out.glob("*.wav")):
        print(f"  {file.name}")
    print(f"\nlisten with:  mpv {args.out}/*.wav     (or open the folder in any player)")


main()
