#!/usr/bin/env python3
"""A live microphone level meter for the terminal: talk or tap the microphone and watch the bar move.

    tools/mic-level                 # the default microphone
    tools/mic-level SOURCE_NAME     # a specific one (see: pactl list short sources)

A working microphone jumps by 15 dB or more when you talk. A flat line that never moves means no signal arrives
(a muted headset cable, the wrong jack or plug, a microphone that needs power, a mute switch...). Ctrl+C stops it.
It only measures the level: nothing is saved."""
import math
import shutil
import struct
import subprocess
import sys

RATE, CHUNK = 16000, 1600  # a reading every tenth of a second


def main():
    if not shutil.which("pw-record"):
        sys.exit("pw-record is needed (PipeWire)")
    command = ["pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16"]
    if len(sys.argv) > 1:
        command += ["--target", sys.argv[1]]
    process = subprocess.Popen(command + ["-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    # pw-record writes a ".snd" stream to stdout: a header (its length is in bytes 4 to 8), then BIG-endian 16-bit samples
    header = process.stdout.read(8)
    if header[:4] != b".snd":
        sys.exit("pw-record gave an unexpected format")
    process.stdout.read(struct.unpack(">I", header[4:8])[0] - 8)
    low, high = 0.0, -120.0
    print("speak or tap the microphone; Ctrl+C to stop\n")
    try:
        while True:
            data = process.stdout.read(CHUNK * 2)
            if len(data) < CHUNK * 2:
                break
            samples = struct.unpack(f">{CHUNK}h", data)
            rms = math.sqrt(sum(s * s for s in samples) / CHUNK) / 32768
            level = 20 * math.log10(max(rms, 1e-6))
            low, high = (level if high == -120.0 else min(low, level)), max(high, level)
            bar = "#" * max(0, int((level + 80) / 80 * 50))
            print(f"\r{level:6.1f} dB |{bar:<50}| moved {high - low:4.0f} dB so far   ", end="", flush=True)
    except KeyboardInterrupt:
        pass
    finally:
        process.terminate()
        print()


main()
